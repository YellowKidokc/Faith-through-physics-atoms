{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faiththruphysics.com/schema/claim-pipeline-receipt/v1",
  "title": "Three-stage claim pipeline receipt",
  "type": "object",
  "required": ["receipt_version", "run_id", "created_at", "provider", "model", "capsule_hash", "stages", "final_status", "canonical_promotion_performed"],
  "properties": {
    "receipt_version": {"const": "claim-pipeline-receipt/1.0.0"},
    "run_id": {"type": "string"},
    "created_at": {"type": "string"},
    "provider": {"enum": ["deepseek", "mock"]},
    "model": {"type": "string"},
    "capsule_hash": {"type": "string"},
    "stages": {"type": "array", "minItems": 1, "maxItems": 3},
    "final_status": {"enum": ["PASS", "PASS_WITH_WARNINGS", "EXCEPTION_HUMAN_REVIEW_REQUIRED", "BLOCKED"]},
    "canonical_promotion_performed": {"const": false}
  }
}
