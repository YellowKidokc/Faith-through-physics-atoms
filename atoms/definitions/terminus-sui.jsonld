  "dateCreated": "2026-07-28",
  "dateModified": "2026-07-28",
  "version": "1.0.0",
  "claimKind": "definition",
  "claimClass": "cross-domain synthesis",
  "statementTechnical": "Terminus Sui names the recurrent architecture in which sufficiently rich systems encounter domain-specific limits on what they can prove, define, decide, maintain, or irreversibly erase using only operations and resources available within the relevant closure.",
  "statementPlain": "At some point, every sufficiently rich system reaches something it cannot fully prove, define, predict, maintain, or erase from inside its own closure.",
  "scopeBoundary": "This atom does not claim that Gödel, Tarski, Turing, Clausius, or Landauer individually proved God, nor that their theorems are mathematically identical. The shared architecture is the Theophysics synthesis; each source theorem retains its native hypotheses and domain.",
  "mathematicalForm": "Established domain-specific limits => Terminus Sui as a cross-domain synthesis",
  "theoremDefinitions": [
    {
      "name": "Gödel incompleteness",
      "definition": "A consistent formal system capable of sufficient elementary arithmetic is incomplete; under the second theorem's conditions, it cannot prove its own consistency."
    },
    {
      "name": "Tarski undefinability",
      "definition": "A sufficiently expressive consistent formal theory cannot contain an unrestricted truth predicate satisfying the full T-schema for its own language."
    },
    {
      "name": "Turing undecidability",
      "definition": "No Turing machine decides the halting problem for every arbitrary Turing machine and input."
    },
    {
      "name": "Second Law of Thermodynamics",
      "definition": "For the relevant isolated or thermally closed systems and stated thermodynamic conditions, spontaneous evolution does not proceed toward lower total entropy."
    },
    {
      "name": "Landauer principle",
      "definition": "Logically irreversible bit reset has a minimum thermodynamic work/heat cost under the principle's physical assumptions."
    }
  ],
  "citationPolicy": {
    "required": true,
    "mode": "quote_or_link",
    "rule": "Any public rendering, quotation, or reuse of this claim must include at least one authoritative source link and must preserve the scope boundary. When space permits, render the exact quotation with its source.",
    "minimumSources": 1
  },
  "citations": [
    {
      "citationID": "src:SEP-GODEL-INCOMPLETENESS",
      "sourceName": "Stanford Encyclopedia of Philosophy — Gödel's Incompleteness Theorems",
      "sourceURL": "https://plato.stanford.edu/entries/goedel-incompleteness/",
      "exactQuote": "Any consistent formal system F within which a certain amount of elementary arithmetic can be carried out is incomplete.",
      "supports": "Gödel incompleteness scope"
    },
    {
      "citationID": "src:SEP-GODEL-OUTSIDE",
      "sourceName": "Stanford Encyclopedia of Philosophy — A Philosophical Argument About the Content of Mathematics",
      "sourceURL": "https://plato.stanford.edu/archives/win2021/entries/goedel/content-mathematics.html",
      "exactQuote": "Consistency will never be intrinsic to the system; it must always be imported “from the outside,” so to speak.",
      "supports": "Metatheoretic outside-language interpretation; not a proof of a divine source"
    },
    {
      "citationID": "src:SEP-TARSKI",
      "sourceName": "Stanford Encyclopedia of Philosophy — Self-Reference and Paradox",
      "sourceURL": "https://plato.stanford.edu/entries/self-reference/",
      "exactQuote": "Any theory extending first-order arithmetic and containing schema T is inconsistent.",
      "supports": "Tarski undefinability scope"
    },
    {
      "citationID": "src:SEP-TURING",
      "sourceName": "Stanford Encyclopedia of Philosophy — Self-Reference and Paradox",
      "sourceURL": "https://plato.stanford.edu/archives/sum2011/entries/self-reference/",
      "exactQuote": "There exists no Turing machine deciding the halting problem.",
      "supports": "Turing undecidability scope"
    },
    {
      "citationID": "src:SEP-THERMO",
      "sourceName": "Stanford Encyclopedia of Philosophy — Thermodynamic Asymmetry in Time",
      "sourceURL": "https://plato.stanford.edu/entries/time-thermo/",
      "exactQuote": "In the spontaneous evolution of a thermally closed system the entropy can never decrease.",
      "supports": "Thermodynamic scope"
    },
    {
      "citationID": "src:SEP-LANDAUER",
      "sourceName": "Stanford Encyclopedia of Philosophy — Information Processing and Thermodynamic Entropy",
      "sourceURL": "https://plato.stanford.edu/entries/information-entropy/",
      "exactQuote": "reset a bit to zero converting less than kT ln 2 of work into heat",
      "supports": "Landauer reset cost"
    }
  ],
