    "definition":  {"prefix": "DEF", "glyph": "≝", "concept": "definition-lock", "file": "node-types/definition.ico"},
    "story":       {"prefix": "STY", "glyph": "✍", "concept": "open-story-scroll", "file": "node-types/story.ico"},
    "evidence":    {"prefix": "EVD", "glyph": "E", "concept": "evidence-receipt", "file": "node-types/evidence.ico"},
    "bridge":      {"prefix": "BRG", "glyph": "≅", "concept": "graded-bridge", "file": "node-types/bridge.ico"},
    "kill":        {"prefix": "KIL", "glyph": "⛔", "concept": "countermodel-break", "file": "node-types/kill.ico"},
    "proof":       {"prefix": "PRF", "glyph": "⊢", "concept": "proof-check", "file": "node-types/proof.ico"},
