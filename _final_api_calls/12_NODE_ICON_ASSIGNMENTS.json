    "result":      {"prefix": "RES", "glyph": "⟡", "concept": "result-receipt", "file": "node-types/result.ico"},
    "source":      {"prefix": "SRC", "glyph": "⊡", "concept": "source-anchor", "file": "node-types/source.ico"}
